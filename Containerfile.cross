# syntax=docker/dockerfile:1
#
# semantic-links:
#   skill-links:
#     - add-workspace-member
#   related-artifacts:
#     - Containerfile  # the QEMU-based production build this throwaway replaces for arm64 testing
#     - Cargo.toml  # `[target.'cfg(target_env = "musl")'.dependencies]` enables vendored OpenSSL for musl
#     - .dockerignore  # allow-list of the build context
#     - .hadolint.yaml  # global hadolint rules
#
# Throwaway, QEMU-free arm64 cross-build driven by `cargo-zigbuild`.
#
# Build strategy
#   * `cross_builder` runs on `$BUILDPLATFORM` (the host running buildx, always
#     amd64 on GitHub-hosted runners). It installs the Zig C compiler and
#     `cargo-zigbuild`, then cross-compiles fully-static `musl` binaries for
#     `$TARGETPLATFORM` through Zig. No QEMU is involved: Zig supplies the C
#     compiler and archiver for the target triple, and OpenSSL is
#     compiled from source (vendored) through that same Zig toolchain (see the
#     `target_env = "musl"` dependency in Cargo.toml).
#   * The `runtime` and `release` stages run on `$TARGETPLATFORM` and use only
#     `COPY` (plus `ENV`/`EXPOSE`/`VOLUME`/`ENTRYPOINT`/`CMD`). Docker assembles
#     them by pulling the matching multi-arch base and layering platform-correct
#     files, so they need no QEMU either.
#   * Because the binaries are statically-linked `musl`, the distroless runtime
#     needs no glibc / libz shared objects — unlike the production `Containerfile`,
#     which extracts and copies `libz.so.1` into `/usr/lib`.
#
# Why default features (not `--all-features`)
#   The production `Containerfile` builds `--all-features`, which enables more
#   features (including a cmake-driven crypto crate) that need extra cross-link
#   wiring under cargo-zigbuild. This throwaway builds the default feature set
#   to validate the QEMU-free pipeline; closing the `--all-features` gap is a
#   documented follow-up (see `measure-arm64.yaml` for the crate and feature
#   that this omits).
#
# References:
#   https://gist.github.com/aalkhodiry/ad45e414af1e5471e00c8dd0b4fa7fe4
#   https://github.com/rust-cross/cargo-zigbuild

## Tool Versions

ARG ZIG_VERSION=0.13.0
ARG CARGO_ZIGBUILD_VERSION=0.21.8

## Cross Builder (BUILDPLATFORM)
# Toolchains are installed on $BUILDPLATFORM so the layer is built once and
# shared by both target platforms. Builds fully-static `musl` binaries for
# $TARGETPLATFORM via `cargo-zigbuild`, then copies them to /out.
FROM --platform=$BUILDPLATFORM docker.io/library/rust:slim-trixie AS cross_builder
WORKDIR /tmp

ARG TARGETARCH
ARG ZIG_VERSION
ARG CARGO_ZIGBUILD_VERSION
ENV DEBIAN_FRONTEND=noninteractive

# Zig: provides the C compiler and archiver for the target `musl` triple.
# Pinned to v0.13.0 to avoid the `ring`/`libc++-19` breakage seen on Zig >= 0.15.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*
RUN curl -L --proto '=https' --tlsv1.2 -sSf https://ziglang.org/download/${ZIG_VERSION}/zig-linux-x86_64-${ZIG_VERSION}.tar.xz -o /tmp/zig.tar.xz \
 && tar -xJf /tmp/zig.tar.xz -C /usr/local --strip-components=1 \
 && rm -f /tmp/zig.tar.xz
RUN zig version

# `cargo-zigbuild` is installed with `cargo-binstall` (same pattern as the
# production `chef` stage) and both `musl` standard-library targets are added.
RUN curl -L --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash \
 && cargo binstall --no-confirm --locked cargo-zigbuild@${CARGO_ZIGBUILD_VERSION}
RUN rustup target add x86_64-unknown-linux-musl aarch64-unknown-linux-musl

# The whole allow-listed repository is the build context (see .dockerignore).
# `.cargo/config.toml` (rustflags, e.g. `-D warnings`) and `Cargo.lock` are
# copied in and respected: the cross build is held to the same strict compiler
# flags as the glibc production builds.
WORKDIR /build
COPY . /build

# No `--locked`: the `cfg(target_env = "musl")` vendored `native-tls` dependency
# pulls `openssl-src` (not present in the committed glibc `Cargo.lock`), so the
# lock is updated ephemerally in this throwaway builder only — never committed.
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) RUST_TARGET=x86_64-unknown-linux-musl;  ZIG_TARGET=x86_64-linux-musl  ;; \
      arm64) RUST_TARGET=aarch64-unknown-linux-musl; ZIG_TARGET=aarch64-linux-musl ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    mkdir -p /out; \
    cargo zigbuild --release --target "${RUST_TARGET}" \
      --bin torrust-tracker --bin http_health_check; \
    cp target/"${RUST_TARGET}"/release/torrust-tracker /out/torrust-tracker; \
    cp target/"${RUST_TARGET}"/release/http_health_check /out/http_health_check; \
    # Static build matching production su-exec flags (`-static -g`).
    zig cc -target "${ZIG_TARGET}" -static -g \
      /build/contrib/dev-tools/su-exec/su-exec.c -o /out/su-exec

## Distroless base (TARGETPLATFORM)
# A second stage of the same distroless image is used only as a COPY source for
# the `/busybox` sh applets — a stage cannot COPY from itself. This mirrors the
# production `Containerfile`'s `RUN /busybox/cp -sp /busybox/{sh,cat,ls,env} /bin/`
# but performs the copy with `COPY` (no QEMU), keeping the runtime QEMU-free.
# Omitting `--platform=$TARGETPLATFORM` (the buildx default) on purpose: hadolint
# flags the explicit form as redundant (DL3065) and the production `Containerfile`
# relies on the same default for its runtime/builder stages.
FROM gcr.io/distroless/cc-debian13:debug AS distroless_base

## Runtime (TARGETPLATFORM)
FROM gcr.io/distroless/cc-debian13:debug AS runtime

COPY --from=distroless_base /busybox/sh /bin/sh
COPY --from=distroless_base /busybox/cat /bin/cat
COPY --from=distroless_base /busybox/ls /bin/ls
COPY --from=distroless_base /busybox/env /bin/env

COPY --from=cross_builder --chmod=0555 /out/su-exec /bin/su-exec

ARG TORRUST_TRACKER_CONFIG_TOML_PATH="/etc/torrust/tracker/tracker.toml"
ARG USER_ID=1000
ARG UDP_PORT=6969
ARG HTTP_PORT=7070
ARG API_PORT=1212
ARG HEALTH_CHECK_API_PORT=1313

ENV TORRUST_TRACKER_CONFIG_TOML_PATH=${TORRUST_TRACKER_CONFIG_TOML_PATH}
ENV USER_ID=${USER_ID}
ENV UDP_PORT=${UDP_PORT}
ENV HTTP_PORT=${HTTP_PORT}
ENV API_PORT=${API_PORT}
ENV HEALTH_CHECK_API_PORT=${HEALTH_CHECK_API_PORT}
ENV TZ=Etc/UTC

EXPOSE ${UDP_PORT}/udp
EXPOSE ${HTTP_PORT}/tcp
EXPOSE ${API_PORT}/tcp
EXPOSE ${HEALTH_CHECK_API_PORT}/tcp

ENV ENV=/etc/profile
COPY --chmod=0555 ./share/container/entry_script_sh /usr/local/bin/entry.sh
COPY ./share/ /usr/share/torrust/

# Directories are materialized by these volumes (and created by the entrypoint
# at runtime), so no `RUN mkdir` is needed — keeping the stage QEMU-free.
VOLUME ["/var/lib/torrust/tracker","/var/log/torrust/tracker","/etc/torrust/tracker"]

ENV RUNTIME="runtime"
ENTRYPOINT ["/usr/local/bin/entry.sh"]

## Torrust-Tracker (release, default)
# Mirrors the production `release` stage, but copies the cross-built static
# binaries from `cross_builder` instead of running target-platform tests.
FROM runtime AS release
ENV RUNTIME="release"

COPY --from=cross_builder --chmod=0555 /out/torrust-tracker /usr/bin/torrust-tracker
COPY --from=cross_builder --chmod=0755 /out/http_health_check /usr/bin/http_health_check

HEALTHCHECK --interval=5s --timeout=5s --start-period=3s --retries=3 \
  CMD /usr/bin/http_health_check http://localhost:${HEALTH_CHECK_API_PORT}/health_check \
    || exit 1
CMD ["/usr/bin/torrust-tracker"]
