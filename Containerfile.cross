# syntax=docker/dockerfile:1
#
# semantic-links:
#   skill-links:
#     - add-workspace-member
#   related-artifacts:
#     - Containerfile  # the QEMU-based production build this throwaway replaces for arm64 testing
#     - Cargo.toml  # `[target.'cfg(target_env = "musl")'.dependencies]` enables vendored OpenSSL for musl
#     - .dockerignore  # allow-list of the build context
#     - .hadolint.yaml  # global hadolint rules
#
# Throwaway, QEMU-free arm64 cross-build driven by `cargo-zigbuild`.
#
# Build strategy
#   * `builder` runs on `$BUILDPLATFORM` (the host executing docker build, always
#     amd64 on GitHub-hosted runners). It is based on the
#     `ghcr.io/rust-cross/cargo-zigbuild` image, which already bundles the latest
#     Zig C compiler, the `cargo-zigbuild` subcommand, the Rust `musl` std targets
#     (`x86_64-unknown-linux-musl`, `aarch64-unknown-linux-musl`) and `clang`
#     (useful for any future cmake-driven crate under `--all-features`). It
#     cross-compiles fully-static `musl` binaries for `$TARGETPLATFORM` through
#     Zig; nothing is installed in this stage and no QEMU is involved.
#   * The `runtime` and `release` stages run on `$TARGETPLATFORM` and use only
#     `COPY` (plus `ENV`/`EXPOSE`/`VOLUME`/`ENTRYPOINT`/`CMD`). Docker assembles
#     them by pulling the matching multi-arch base and layering platform-correct
#     files, so they need no QEMU either.
#   * Because the binaries are statically-linked `musl`, the distroless runtime
#     needs no glibc / libz shared objects — unlike the production `Containerfile`,
#     which extracts and copies `libz.so.1` into `/usr/lib`.
#
# Why default features (not `--all-features`)
#   The production `Containerfile` builds `--all-features`, which enables more
#   features (including a cmake-driven crypto crate) that need extra cross-link
#   wiring under cargo-zigbuild. This throwaway builds the default feature set to
#   validate the QEMU-free pipeline; closing the `--all-features` gap is a
#   documented follow-up (see `measure-arm64.yaml`). The base image already ships
#   `clang`, so only `CMAKE_*_COMPILER` env wiring remains for that follow-up.
#
# Note on the Zig version
#   The image tracks the latest Zig (its source pins `ZIG_VERSION=0.16.0`). Recent
#   Zig releases can break the `ring` crate's build under cross-compilation; the
#   `RUN zig version` line below prints the exact version in the build log. If
#   `cargo zigbuild` fails on `ring`, switch the image tag to a cargo-zigbuild
#   release that bundles a compatible Zig.
#
# References:
#   https://github.com/rust-cross/cargo-zigbuild
#   https://github.com/rust-cross/cargo-zigbuild/pkgs/container/cargo-zigbuild
#   https://ziglang.org/

## Cross Builder (BUILDPLATFORM)
# `:latest` intentionally tracks the cargo-zigbuild image's newest bundled Zig;
# `RUN zig version` below prints it. (Pin a digest/tag for production use.)
# hadolint ignore=DL3007
FROM --platform=$BUILDPLATFORM ghcr.io/rust-cross/cargo-zigbuild:latest AS builder

WORKDIR /build
# The whole allow-listed repository is the build context (see .dockerignore).
# `.cargo/config.toml` (rustflags, e.g. `-D warnings`) and `Cargo.lock` are
# copied in and respected: the cross build is held to the same strict compiler
# flags as the glibc production builds.
COPY . /build

RUN zig version
# No `--locked`: the `cfg(target_env = "musl")` vendored `native-tls` dependency
# pulls `openssl-src` (not present in the committed glibc `Cargo.lock`), so the
# lock is updated in this throwaway builder only — never committed.
RUN set -eu; \
    case "${TARGETPLATFORM}" in \
      linux/amd64)  RUST_TARGET=x86_64-unknown-linux-musl;  ZIG_TARGET=x86_64-linux-musl  ;; \
      linux/arm64)  RUST_TARGET=aarch64-unknown-linux-musl; ZIG_TARGET=aarch64-linux-musl ;; \
      *) echo "unsupported TARGETPLATFORM: ${TARGETPLATFORM}" >&2; exit 1 ;; \
    esac; \
    mkdir -p /out; \
    cargo zigbuild --release --target "${RUST_TARGET}" \
      --bin torrust-tracker --bin http_health_check; \
    cp target/"${RUST_TARGET}"/release/torrust-tracker /out/torrust-tracker; \
    cp target/"${RUST_TARGET}"/release/http_health_check /out/http_health_check; \
    # Static build matching production su-exec flags (`-static -g`).
    zig cc -target "${ZIG_TARGET}" -static -g \
      /build/contrib/dev-tools/su-exec/su-exec.c -o /out/su-exec

## Distroless base (TARGETPLATFORM)
# A second stage of the same distroless image is used only as a COPY source for
# the `/busybox` sh applets — a stage cannot COPY from itself. This mirrors the
# production `Containerfile`'s `RUN /busybox/cp -sp /busybox/{sh,cat,ls,env} /bin/`
# but performs the copy with `COPY` (no QEMU), keeping the runtime QEMU-free.
# Omitting `--platform=$TARGETPLATFORM` (the docker build default) on purpose:
# hadolint flags the explicit form as redundant (DL3065) and the production
# `Containerfile` relies on the same default for its runtime/builder stages.
FROM gcr.io/distroless/cc-debian13:debug AS base

## Runtime (TARGETPLATFORM)
FROM gcr.io/distroless/cc-debian13:debug AS runtime

COPY --from=base /busybox/sh /bin/sh
COPY --from=base /busybox/cat /bin/cat
COPY --from=base /busybox/ls /bin/ls
COPY --from=base /busybox/env /bin/env

COPY --from=builder --chmod=0555 /out/su-exec /bin/su-exec

ARG TORRUST_TRACKER_CONFIG_TOML_PATH="/etc/torrust/tracker/tracker.toml"
ARG USER_ID=1000
ARG UDP_PORT=6969
ARG HTTP_PORT=7070
ARG API_PORT=1212
ARG HEALTH_CHECK_API_PORT=1313

ENV TORRUST_TRACKER_CONFIG_TOML_PATH=${TORRUST_TRACKER_CONFIG_TOML_PATH}
ENV USER_ID=${USER_ID}
ENV UDP_PORT=${UDP_PORT}
ENV HTTP_PORT=${HTTP_PORT}
ENV API_PORT=${API_PORT}
ENV HEALTH_CHECK_API_PORT=${HEALTH_CHECK_API_PORT}
ENV TZ=Etc/UTC

EXPOSE ${UDP_PORT}/udp
EXPOSE ${HTTP_PORT}/tcp
EXPOSE ${API_PORT}/tcp
EXPOSE ${HEALTH_CHECK_API_PORT}/tcp

ENV ENV=/etc/profile
COPY --chmod=0555 ./share/container/entry_script_sh /usr/local/bin/entry.sh
COPY ./share/ /usr/share/torrust/

# Directories are provided by these volumes (and created by the entrypoint
# at runtime), so no `RUN mkdir` is needed — keeping the stage QEMU-free.
VOLUME ["/var/lib/torrust/tracker","/var/log/torrust/tracker","/etc/torrust/tracker"]

ENV RUNTIME="runtime"
ENTRYPOINT ["/usr/local/bin/entry.sh"]

## Torrust-Tracker (release, default)
# Mirrors the production `release` stage, but copies the cross-built static
# binaries from `builder` instead of running target-platform tests.
FROM runtime AS release
ENV RUNTIME="release"

COPY --from=builder --chmod=0555 /out/torrust-tracker /usr/bin/torrust-tracker
COPY --from=builder --chmod=0755 /out/http_health_check /usr/bin/http_health_check

HEALTHCHECK --interval=5s --timeout=5s --start-period=3s --retries=3 \
  CMD /usr/bin/http_health_check http://localhost:${HEALTH_CHECK_API_PORT}/health_check \
    || exit 1
CMD ["/usr/bin/torrust-tracker"]
